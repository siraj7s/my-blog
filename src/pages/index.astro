---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import profilePhoto from "../assets/my_pro.png";

const allPosts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const posts = allPosts.map((post) => {
	const words = post.body?.trim().split(/\s+/).filter(Boolean).length ?? 0;
	const readTime = Math.max(1, Math.round(words / 200));
	return {
		slug: post.id,
		title: post.data.title,
		excerpt: post.data.description,
		date: post.data.pubDate.toLocaleDateString("en-us", {
			year: "numeric",
			month: "short",
		}),
		readTime: `${readTime} min`,
		tags: post.data.tags ?? [],
		heroImage: post.data.heroImage,
	};
});

const extraTags = ["poetry", "my views"];
const tagSet = new Set<string>(extraTags);
posts.forEach((p) => p.tags.forEach((t) => tagSet.add(t)));
const filters = ["all", ...Array.from(tagSet)];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link
			rel="preconnect"
			href="https://fonts.gstatic.com"
			crossorigin="anonymous"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			(function () {
				const saved = localStorage.getItem("theme");
				const dark =
					saved === "dark" ||
					(!saved &&
						window.matchMedia("(prefers-color-scheme: dark)").matches);
				if (dark) document.documentElement.dataset.theme = "dark";
			})();
		</script>
	</head>
	<body>
		<header class="site-header">
			<a href="#top" class="logo">siraj<span class="accent">.</span>dev</a>
			<nav>
				<a href="#blog">blog</a>
				<a href="#connect">connect</a>
				<button type="button" id="theme-toggle" title="Toggle theme"
					>dark</button
				>
			</nav>
		</header>

		<main>
			<section id="top" class="hero">
				<Image src={profilePhoto} alt="Siraj Panigrahi" width={150} height={150} class="avatar" />

				<h1>
					<span class="muted">Hi, I'm</span> <span id="typed-name"></span><span
						class="cursor"></span>
				</h1>

				<div class="tagline-block">
					<div class="tagline">The audacity to learn anything, and ship it.</div>
					<div class="role">
						<span class="dot"></span>
						Software Engineer @ Atriina
					</div>
				</div>

				<p class="bio">
					👋 Hii I'am siraj -&gt; 3rd-year engineering student, building
					stuff with Frappe (also worked with Django and Rails). I like
					solving real problems with code, not just writing it. Right now
					I'm shifting from "just build it myself" to actually leading a
					team and owning projects end to end.<br />
					Big on open source — I learn a ton from the community and try
					to give back. Also messing around with AI in my day-to-day dev
					work.
				</p>

				<div class="links">
					<a href="https://github.com/siraj7s" target="_blank" rel="noreferrer"
						>GitHub ↗</a
					>
					<a
						href="https://www.linkedin.com/in/sirajpanigrahi/"
						target="_blank"
						rel="noreferrer">LinkedIn ↗</a
					>
					<a href="mailto:siraj.panigrahi@atriina.com">Email ↗</a>
				</div>
			</section>

			<section id="blog" class="writing">
				<div class="section-head">
					<h2>Writing</h2>
					<span id="post-count" class="mono muted">{posts.length} {posts.length === 1 ? "post" : "posts"}</span>
				</div>

				<div class="filters">
					{
						filters.map((f) => (
							<button type="button" class="filter-btn" data-tag={f} class:list={[{ active: f === "all" }]}>
								{f}
							</button>
						))
					}
				</div>

				<div class="post-list">
					{
						posts.map((post) => (
							<a href={`/blog/${post.slug}/`} class="post" data-tags={post.tags.join(",")}>
								<div class="cover">
									{post.heroImage ? (
										<Image src={post.heroImage} alt="" width={132} height={92} />
									) : (
										<span class="cover-placeholder">Cover</span>
									)}
								</div>
								<div class="post-body">
									<div class="meta mono muted">
										<span>{post.date}</span>
										<span>·</span>
										<span>{post.readTime}</span>
									</div>
									<h3>{post.title}</h3>
									<p class="excerpt">{post.excerpt}</p>
									<div class="tags mono muted">
										{post.tags.map((tag) => <span>#{tag}</span>)}
									</div>
								</div>
							</a>
						))
					}
				</div>
			</section>

			<section id="connect" class="connect">
				<h2>Get in touch</h2>
				<p>
					I'd love to connect with fellow developers, open-source
					enthusiasts, and anyone interested in building meaningful tech.
				</p>
				<p>
					Feel free to reach out if you have questions about Frappe
					development, need help with ERPNext customization, or want to
					connect.
				</p>
				<p>
					I enjoy helping other developers, especially those with a
					passion for programming.
				</p>

				<form id="contact-form">
					<input
						type="email"
						name="email"
						id="contact-email"
						placeholder="your@email.dev"
						required
					/>
					<textarea
						name="message"
						id="contact-message"
						rows="3"
						placeholder="What are we building?"
						required></textarea>
					<button type="submit" id="contact-submit">Send message →</button>
					<div id="contact-sent" class="sent-note" hidden>
						✓ Opening your email client — send it across and I'll reply
						within a day or two.
					</div>
				</form>
			</section>

			<p class="signoff">"Don't forget to be awesome 😉"</p>
		</main>

		<footer class="site-footer mono muted">
			<span>Siraj Panigrahi • Jagdalpur, Chhattisgarh • {year}</span>
		</footer>

		<style>
			:root {
				--bg: #fbfaf7;
				--card: #ffffff;
				--fg: #16181c;
				--fg-soft: #3e4348;
				--fg-mute: #5c6166;
				--muted: #6e7378;
				--faint: #8a8f94;
				--border: #e7e3da;
				--border-soft: #ede9e0;
				--input-border: #ddd8ce;
				--hover-bg: #f3f1eb;
				--accent: #c2410c;
				--accent-dark: #9a3412;
			}
			:root[data-theme="dark"] {
				--bg: #0e1012;
				--card: #15181b;
				--fg: #ecEAe6;
				--fg-soft: #b9bec4;
				--fg-mute: #a6acb2;
				--muted: #949aa0;
				--faint: #868c92;
				--border: #262a2e;
				--border-soft: #22262a;
				--input-border: #2b3035;
				--hover-bg: #1a1e22;
				--accent: #fb923c;
				--accent-dark: #f0b08e;
			}

			html {
				scroll-behavior: smooth;
			}
			body {
				margin: 0;
				background: var(--bg);
				color: var(--fg);
				font-family: "Space Grotesk", system-ui, sans-serif;
				-webkit-font-smoothing: antialiased;
				transition: background 160ms ease, color 160ms ease;
			}
			a {
				color: var(--accent);
				text-decoration: none;
			}
			a:hover {
				color: var(--accent-dark);
			}
			.mono {
				font-family: "JetBrains Mono", monospace;
			}
			.muted {
				color: var(--muted);
			}
			@keyframes blink {
				0%, 49% { opacity: 1; }
				50%, 100% { opacity: 0; }
			}

			.site-header {
				position: sticky;
				top: 0;
				z-index: 50;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 16px;
				padding: 16px clamp(20px, 6vw, 48px);
				background: color-mix(in srgb, var(--bg) 88%, transparent);
				backdrop-filter: blur(10px);
				border-bottom: 1px solid var(--border);
			}
			.logo {
				font-family: "JetBrains Mono", monospace;
				font-size: 14px;
				font-weight: 700;
				color: var(--fg);
			}
			.logo:hover {
				color: var(--fg);
			}
			.logo .accent {
				color: var(--accent);
			}
			.site-header nav {
				display: flex;
				align-items: center;
				gap: clamp(16px, 3vw, 28px);
				font-family: "JetBrains Mono", monospace;
				font-size: 13px;
			}
			.site-header nav a {
				color: var(--muted);
			}
			.site-header nav a:hover {
				color: var(--fg);
			}
			#theme-toggle {
				padding: 6px 12px;
				border: 1px solid var(--input-border);
				border-radius: 999px;
				background: var(--card);
				color: var(--muted);
				font-family: "JetBrains Mono", monospace;
				font-size: 12.5px;
				cursor: pointer;
				transition: border-color 160ms ease, color 160ms ease;
			}
			#theme-toggle:hover {
				border-color: var(--fg);
				color: var(--fg);
			}

			main {
				max-width: 760px;
				margin: 0 auto;
				padding: 0 clamp(20px, 6vw, 48px);
			}

			.hero {
				display: grid;
				gap: 26px;
				padding: clamp(56px, 10vw, 104px) 0 clamp(48px, 8vw, 80px);
			}
			.avatar {
				width: 150px;
				height: 150px;
				border-radius: 50%;
				object-fit: cover;
				border: 1px solid var(--input-border);
				display: block;
			}
			.hero h1 {
				margin: 0;
				font-size: clamp(36px, 7vw, 60px);
				line-height: 1.05;
				letter-spacing: -0.035em;
				font-weight: 700;
				text-wrap: balance;
			}
			.cursor {
				display: inline-block;
				width: 0.42em;
				height: 0.08em;
				margin-left: 0.1em;
				background: var(--accent);
				vertical-align: 0.06em;
				animation: blink 1.1s steps(1) infinite;
			}
			.tagline-block {
				display: grid;
				gap: 12px;
			}
			.tagline {
				font-size: clamp(17px, 2.4vw, 22px);
				line-height: 1.35;
				letter-spacing: -0.015em;
				font-weight: 500;
				color: var(--fg-soft);
				text-wrap: balance;
			}
			.role {
				font-family: "JetBrains Mono", monospace;
				font-size: 14px;
				color: var(--muted);
				display: flex;
				align-items: center;
				gap: 8px;
			}
			.dot {
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: var(--accent);
			}
			.bio {
				margin: 0;
				font-size: clamp(15.5px, 1.8vw, 17.5px);
				line-height: 1.7;
				color: var(--fg-soft);
				text-wrap: pretty;
			}
			.links {
				display: flex;
				flex-wrap: wrap;
				gap: 10px;
				font-family: "JetBrains Mono", monospace;
				font-size: 13px;
				margin-top: 2px;
			}
			.links a {
				padding: 10px 16px;
				border: 1px solid var(--input-border);
				border-radius: 7px;
				color: var(--fg);
				background: var(--card);
				transition: border-color 160ms ease, transform 160ms ease;
			}
			.links a:hover {
				border-color: var(--fg);
				transform: translateY(-1px);
				color: var(--fg);
			}

			.writing {
				display: grid;
				gap: 24px;
				padding: clamp(40px, 7vw, 72px) 0;
				border-top: 1px solid var(--border);
			}
			.section-head {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				justify-content: space-between;
				gap: 12px;
			}
			.section-head h2, .connect h2 {
				margin: 0;
				font-size: clamp(22px, 3vw, 28px);
				letter-spacing: -0.02em;
				font-weight: 700;
			}
			#post-count {
				font-size: 12.5px;
				color: var(--faint);
			}
			.filters {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
			}
			.filter-btn {
				padding: 6px 12px;
				border-radius: 999px;
				cursor: pointer;
				font-family: "JetBrains Mono", monospace;
				font-size: 12.5px;
				transition: all 160ms ease;
				border: 1px solid var(--input-border);
				background: transparent;
				color: var(--muted);
			}
			.filter-btn.active {
				border-color: var(--fg);
				background: var(--fg);
				color: var(--bg);
			}
			.post-list {
				display: grid;
			}
			.post {
				display: grid;
				grid-template-columns: 132px minmax(0, 1fr);
				align-items: start;
				gap: 18px;
				padding: 22px 16px;
				margin: 0 -16px;
				border-radius: 10px;
				border-bottom: 1px solid var(--border-soft);
				color: var(--fg);
				transition: background 160ms ease;
			}
			.post:hover {
				background: var(--hover-bg);
				color: var(--fg);
			}
			.cover {
				width: 132px;
				height: 92px;
				border-radius: 8px;
				overflow: hidden;
				background: var(--hover-bg);
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.cover :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.cover-placeholder {
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: var(--faint);
			}
			.post-body {
				display: grid;
				gap: 8px;
			}
			.meta {
				display: flex;
				align-items: center;
				gap: 10px;
				font-size: 11.5px;
			}
			.post-body h3 {
				margin: 0;
				font-size: 18.5px;
				line-height: 1.35;
				letter-spacing: -0.015em;
				font-weight: 700;
				text-wrap: pretty;
			}
			.excerpt {
				margin: 0;
				font-size: 15px;
				line-height: 1.6;
				color: var(--fg-mute);
				text-wrap: pretty;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 6px;
				margin-top: 4px;
				font-size: 11px;
			}

			.connect {
				display: grid;
				gap: 20px;
				padding: clamp(40px, 7vw, 72px) 0 32px;
				border-top: 1px solid var(--border);
			}
			.connect h2 {
				line-height: 1.15;
				letter-spacing: -0.025em;
				text-wrap: balance;
				max-width: 20ch;
			}
			.connect p {
				margin: 0;
				max-width: 52ch;
				font-size: 16px;
				line-height: 1.65;
				color: var(--fg-soft);
				text-wrap: pretty;
			}
			#contact-form {
				display: grid;
				gap: 12px;
				max-width: 460px;
				margin-top: 6px;
			}
			#contact-form input,
			#contact-form textarea {
				padding: 12px 14px;
				border: 1px solid var(--input-border);
				border-radius: 8px;
				background: var(--card);
				color: var(--fg);
				font-family: "Space Grotesk", sans-serif;
				font-size: 15px;
				outline: none;
			}
			#contact-form textarea {
				line-height: 1.55;
				resize: vertical;
			}
			#contact-form input:focus,
			#contact-form textarea:focus {
				border-color: var(--fg);
			}
			#contact-submit {
				justify-self: start;
				padding: 12px 20px;
				border: none;
				border-radius: 8px;
				background: var(--fg);
				color: var(--bg);
				font-family: "JetBrains Mono", monospace;
				font-size: 13px;
				font-weight: 700;
				cursor: pointer;
				transition: transform 160ms ease, background 160ms ease;
			}
			#contact-submit:hover {
				transform: translateY(-1px);
				background: var(--accent);
			}
			.sent-note {
				font-family: "JetBrains Mono", monospace;
				font-size: 12.5px;
				color: var(--accent);
			}

			.signoff {
				margin: 0;
				padding: 0 0 28px;
				text-align: center;
				font-style: italic;
				font-size: 16px;
				line-height: 1.6;
				color: var(--faint);
			}

			.site-footer {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: center;
				text-align: center;
				gap: 6px 12px;
				max-width: 760px;
				margin: 0 auto;
				padding: 20px clamp(20px, 6vw, 48px) 40px;
				border-top: 1px solid var(--border);
				font-size: 12px;
				color: var(--faint);
			}
		</style>

		<script>
			const fullName = "Siraj Panigrahi";
			const typedEl = document.getElementById("typed-name");
			if (typedEl) {
				let i = 0;
				const timer = setInterval(() => {
					i += 1;
					typedEl.textContent = fullName.slice(0, i);
					if (i >= fullName.length) clearInterval(timer);
				}, 75);
			}

			const themeToggle = document.getElementById("theme-toggle");
			function syncThemeLabel() {
				if (!themeToggle) return;
				themeToggle.textContent =
					document.documentElement.dataset.theme === "dark" ? "light" : "dark";
			}
			syncThemeLabel();
			themeToggle?.addEventListener("click", () => {
				const isDark = document.documentElement.dataset.theme === "dark";
				if (isDark) {
					delete document.documentElement.dataset.theme;
					localStorage.setItem("theme", "light");
				} else {
					document.documentElement.dataset.theme = "dark";
					localStorage.setItem("theme", "dark");
				}
				syncThemeLabel();
			});

			const filterBtns = document.querySelectorAll(".filter-btn");
			const postEls = document.querySelectorAll(".post");
			const postCount = document.getElementById("post-count");
			filterBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					filterBtns.forEach((b) => b.classList.remove("active"));
					btn.classList.add("active");
					const tag = btn.dataset.tag;
					let visible = 0;
					postEls.forEach((post) => {
						const tags = (post.getAttribute("data-tags") || "").split(",");
						const show = tag === "all" || tags.includes(tag);
						post.style.display = show ? "" : "none";
						if (show) visible += 1;
					});
					if (postCount) postCount.textContent = `${visible} ${visible === 1 ? "post" : "posts"}`;
				});
			});

			const form = document.getElementById("contact-form");
			const sentNote = document.getElementById("contact-sent");
			const submitBtn = document.getElementById("contact-submit");
			form?.addEventListener("submit", (e) => {
				e.preventDefault();
				const email = document.getElementById("contact-email").value;
				const message = document.getElementById("contact-message").value;
				const subject = encodeURIComponent(`Portfolio contact from ${email}`);
				const body = encodeURIComponent(message);
				window.location.href = `mailto:siraj.panigrahi@atriina.com?subject=${subject}&body=${body}`;
				if (submitBtn) submitBtn.textContent = "Sent ✓";
				if (sentNote) sentNote.hidden = false;
			});
		</script>
	</body>
</html>
