---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ThemeAssets from "../components/ThemeAssets.astro";
import FormattedDate from "../components/FormattedDate.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<ThemeAssets />
	</head>

	<body>
		<SiteHeader homeHref="/" />
		<main>
			<article>
				<div class="post-head">
					<a href="/#blog" class="back mono">← writing</a>
					<div class="meta mono muted">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="updated">
									· updated <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
					<h1>{title}</h1>
					{
						tags && tags.length > 0 && (
							<div class="tags mono muted">
								{tags.map((tag) => (
									<span>#{tag}</span>
								))}
							</div>
						)
					}
				</div>

				{
					heroImage && (
						<div class="hero-image">
							<Image width={760} height={380} src={heroImage} alt="" />
						</div>
					)
				}

				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<SiteFooter />

		<style>
			main {
				width: 100%;
				max-width: 760px;
				margin: 0 auto;
				padding: 0 clamp(20px, 6vw, 48px);
				box-sizing: border-box;
			}
			.post-head {
				display: grid;
				gap: 14px;
				padding: clamp(40px, 7vw, 72px) 0 clamp(24px, 4vw, 36px);
			}
			.back {
				font-size: 13px;
				color: var(--muted);
				justify-self: start;
			}
			.back:hover {
				color: var(--fg);
			}
			.meta {
				font-size: 12.5px;
			}
			.post-head h1 {
				margin: 0;
				font-size: clamp(28px, 5vw, 44px);
				line-height: 1.1;
				letter-spacing: -0.03em;
				font-weight: 700;
				text-wrap: balance;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
				font-size: 11.5px;
			}
			.hero-image {
				margin: 0 0 clamp(24px, 5vw, 40px);
				border-radius: 12px;
				overflow: hidden;
				border: 1px solid var(--border);
			}
			.hero-image :global(img) {
				display: block;
				width: 100%;
				height: auto;
			}

			.prose {
				padding-bottom: clamp(56px, 9vw, 96px);
				font-size: 16.5px;
				line-height: 1.75;
				color: var(--fg-soft);
			}
			.prose :global(h2) {
				margin: 2em 0 0.6em;
				font-size: 26px;
				line-height: 1.25;
				letter-spacing: -0.02em;
				font-weight: 700;
				color: var(--fg);
			}
			.prose :global(h3) {
				margin: 1.8em 0 0.5em;
				font-size: 21px;
				line-height: 1.3;
				letter-spacing: -0.015em;
				font-weight: 700;
				color: var(--fg);
			}
			.prose :global(h4) {
				margin: 1.6em 0 0.5em;
				font-size: 18px;
				font-weight: 700;
				color: var(--fg);
			}
			.prose :global(p) {
				margin: 0 0 1.2em;
			}
			.prose :global(a) {
				text-decoration: underline;
				text-underline-offset: 2px;
			}
			.prose :global(strong) {
				color: var(--fg);
				font-weight: 700;
			}
			.prose :global(blockquote) {
				margin: 1.6em 0;
				padding: 4px 0 4px 18px;
				border-left: 3px solid var(--accent);
				color: var(--fg-mute);
				font-style: italic;
			}
			.prose :global(hr) {
				margin: 2.4em 0;
				border: none;
				border-top: 1px solid var(--border);
			}
			.prose :global(ul),
			.prose :global(ol) {
				margin: 0 0 1.2em;
				padding-left: 1.4em;
			}
			.prose :global(li) {
				margin: 0.35em 0;
			}
			.prose :global(img) {
				max-width: 100%;
				height: auto;
				border-radius: 10px;
				border: 1px solid var(--border);
				margin: 1.6em 0;
				display: block;
			}
			.prose :global(code) {
				font-family: "JetBrains Mono", monospace;
				font-size: 0.88em;
				padding: 2px 6px;
				border-radius: 4px;
				background: var(--hover-bg);
				color: var(--fg);
			}
			.prose :global(pre) {
				margin: 1.6em 0;
				padding: 16px 18px;
				border-radius: 10px;
				background: var(--hover-bg);
				overflow-x: auto;
			}
			.prose :global(pre code) {
				padding: 0;
				background: none;
			}
		</style>
	</body>
</html>
